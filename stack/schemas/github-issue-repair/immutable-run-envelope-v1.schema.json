{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ao.architecture.autonomous-issue-repair.run-envelope.v1",
  "title": "AO Autonomous Issue Repair Immutable Run Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "loop",
    "trigger",
    "discovery",
    "budgets",
    "governance",
    "routing",
    "created_at",
    "expires_at",
    "canonical_digest",
    "predecessor_digest",
    "lineage",
    "stop_conditions",
    "terminal_statuses"
  ],
  "properties": {
    "schema": {"const": "ao.architecture.autonomous-issue-repair.run-envelope.v1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"},
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "trigger", "discovery", "action", "verification", "state", "human_gates"],
      "properties": {
        "goal": {"type": "string", "minLength": 1, "maxLength": 512},
        "trigger": {"type": "string", "minLength": 1, "maxLength": 256},
        "discovery": {"type": "string", "minLength": 1, "maxLength": 256},
        "action": {"type": "string", "minLength": 1, "maxLength": 256},
        "verification": {"type": "string", "minLength": 1, "maxLength": 256},
        "state": {"type": "string", "minLength": 1, "maxLength": 256},
        "human_gates": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "canonical_url", "repository", "default_branch", "pinned_base_commit"],
      "properties": {
        "mode": {"enum": ["explicit_issue", "issue_list"]},
        "canonical_url": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues(/[1-9][0-9]*)?$"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "default_branch": {"type": "string", "minLength": 1, "maxLength": 255},
        "pinned_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_limit", "candidate_limit", "selected_limit"],
      "properties": {
        "snapshot_limit": {"type": "integer", "minimum": 1, "maximum": 50},
        "candidate_limit": {"type": "integer", "minimum": 1, "maximum": 10},
        "selected_limit": {"const": 1}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_clock_seconds", "clone_count", "test_runs", "retry_count", "repair_count", "publication_count"],
      "properties": {
        "wall_clock_seconds": {"type": "integer", "minimum": 1},
        "clone_count": {"type": "integer", "minimum": 0},
        "test_runs": {"type": "integer", "minimum": 1},
        "retry_count": {"type": "integer", "minimum": 0},
        "repair_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "publication_count": {"type": "integer", "minimum": 0, "maximum": 1}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownership_class", "allowed_actions", "denied_actions", "sole_control_auto_merge_opt_in"],
      "properties": {
        "ownership_class": {"enum": ["sole_control", "team", "external", "unknown"]},
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["read_public_metadata", "clone_public_repository", "push_operator_fork", "open_upstream_draft_pr", "open_ready_pr", "request_merge_queue", "auto_merge"]}
        },
        "denied_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["push_upstream", "open_ready_pr", "mark_ready", "approve_review", "merge", "mutate_issue", "publish_release"]}
        },
        "sole_control_auto_merge_opt_in": {"type": "boolean"}
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_branch", "pinned_base_commit", "fork_owner", "repair_branch", "protected_path_classes", "required_checks"],
      "properties": {
        "default_branch": {"type": "string", "minLength": 1, "maxLength": 255},
        "pinned_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "fork_owner": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.-]+$"},
        "repair_branch": {"type": "string", "pattern": "^[A-Za-z0-9._/-]{1,255}$"},
        "protected_path_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "required_checks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "canonical_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "predecessor_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "predecessor_run_id", "predecessor_digest"],
      "properties": {
        "kind": {"enum": ["origin", "narrower_successor"]},
        "predecessor_run_id": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"},
        "predecessor_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "stop_conditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["policy_ambiguity", "security_sensitive", "credential_required", "lease_conflict", "digest_mismatch", "required_check_conflict", "budget_exhausted", "unauthorized_external_write", "concurrent_repository_mutation"]}},
    "terminal_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["completed", "no_eligible_issue", "operator_action_required", "blocked", "expired", "cancelled"]}}
  }
}
