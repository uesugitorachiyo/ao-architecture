{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ao.architecture.autonomous-issue-repair.discovery-result.v1",
  "title": "AO Autonomous Issue Repair Bounded Discovery Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "repository", "default_branch", "head_sha", "source_url", "snapshot_limit", "candidate_limit", "selected_limit", "page_count", "response_digests", "issues", "candidates", "selected_issue_number", "exclusion_ledger", "mutation_performed", "completed_at"],
  "properties": {
    "schema": {"const": "ao.architecture.autonomous-issue-repair.discovery-result.v1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "default_branch": {"type": "string", "minLength": 1, "maxLength": 255},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_url": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues$"},
    "snapshot_limit": {"type": "integer", "minimum": 1, "maximum": 50},
    "candidate_limit": {"type": "integer", "minimum": 1, "maximum": 10},
    "selected_limit": {"const": 1},
    "page_count": {"type": "integer", "minimum": 1},
    "response_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "issues": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "state", "updated_at", "content_digest"],
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "state": {"const": "open"},
          "updated_at": {"type": "string", "format": "date-time"},
          "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_number", "rank", "decision_digest"],
        "properties": {
          "issue_number": {"type": "integer", "minimum": 1},
          "rank": {"type": "integer", "minimum": 1, "maximum": 10},
          "decision_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "selected_issue_number": {"type": ["integer", "null"], "minimum": 1},
    "exclusion_ledger": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_number", "reason_codes", "evidence_digests"],
        "properties": {
          "issue_number": {"type": "integer", "minimum": 1},
          "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
          "evidence_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
        }
      }
    },
    "mutation_performed": {"const": false},
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
