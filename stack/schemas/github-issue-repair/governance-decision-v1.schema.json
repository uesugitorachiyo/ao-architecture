{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ao.architecture.autonomous-issue-repair.governance-decision.v1",
  "title": "AO Autonomous Issue Repair Governance Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "repository", "base_sha", "head_sha", "governance_class", "classification_sources", "push_target", "pull_request_mode", "merge", "protected_path_touched", "required_checks", "action_digest_required", "decided_at"],
  "properties": {
    "schema": {"const": "ao.architecture.autonomous-issue-repair.governance-decision.v1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "governance_class": {"enum": ["sole_control", "team", "external", "unknown"]},
    "classification_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["repository_policy", "branch_rules", "codeowners", "operator_envelope", "unknown_default"]}},
    "push_target": {"enum": ["authorized_operator_repository", "policy_authorized_branch", "operator_owned_fork"]},
    "pull_request_mode": {"enum": ["draft_or_ready_by_policy", "upstream_draft_only"]},
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized", "mode", "approval_kind", "approval_head_sha", "auto_merge_opt_in", "branch_protection_bypassed"],
      "properties": {
        "authorized": {"type": "boolean"},
        "mode": {"enum": ["never", "manual", "merge_queue", "auto_merge"]},
        "approval_kind": {"enum": ["none", "independent_human", "codeowner"]},
        "approval_head_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "auto_merge_opt_in": {"type": "boolean"},
        "branch_protection_bypassed": {"const": false}
      }
    },
    "protected_path_touched": {"type": "boolean"},
    "required_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "conclusion", "head_sha"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 256},
          "conclusion": {"enum": ["success", "failure", "pending", "missing"]},
          "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    },
    "action_digest_required": {"const": true},
    "decided_at": {"type": "string", "format": "date-time"}
  }
}
