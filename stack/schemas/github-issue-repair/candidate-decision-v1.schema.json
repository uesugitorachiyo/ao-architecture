{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ao.architecture.autonomous-issue-repair.candidate-decision.v1",
  "title": "AO Autonomous Issue Repair Candidate Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "repository", "base_sha", "issue_number", "rank", "decision", "eligibility", "reason_codes", "evidence_digests", "expected_behavior_source", "decided_at"],
  "properties": {
    "schema": {"const": "ao.architecture.autonomous-issue-repair.candidate-decision.v1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "issue_number": {"type": "integer", "minimum": 1},
    "rank": {"type": "integer", "minimum": 1, "maximum": 10},
    "decision": {"enum": ["eligible", "selected", "excluded"]},
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open_bug", "target_in_repository", "no_existing_fix", "current_head_unfixed", "security_sensitive", "public_reproduction_feasible", "deterministic_local_reproduction", "expected_behavior_grounded", "bounded_policy_compatible"],
      "properties": {
        "open_bug": {"type": "boolean"},
        "target_in_repository": {"type": "boolean"},
        "no_existing_fix": {"type": "boolean"},
        "current_head_unfixed": {"type": "boolean"},
        "security_sensitive": {"type": "boolean"},
        "public_reproduction_feasible": {"type": "boolean"},
        "deterministic_local_reproduction": {"type": "boolean"},
        "expected_behavior_grounded": {"type": "boolean"},
        "bounded_policy_compatible": {"type": "boolean"}
      }
    },
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "evidence_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "expected_behavior_source": {"enum": ["tests", "documentation", "protocol", "maintainer_statement", "unavailable"]},
    "decided_at": {"type": "string", "format": "date-time"}
  }
}
